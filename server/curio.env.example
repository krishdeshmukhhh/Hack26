# Machine-specific settings for the Curio model server.
# Copy to curio.env next to the scripts and edit. curio.env is gitignored.

# GPUs you're allowed to use on this machine (space-separated nvidia-smi indices).
ALLOWED_GPUS="3"

# Python env that has vLLM >= 0.11 (Qwen3-VL support).
VENV="$HOME/curio-models/venv"

# Model weights folder, and the name clients must use (Curio's llm_model).
MODEL_PATH="$HOME/curio-models/Qwen3-VL-30B-A3B-Instruct-FP8"
SERVED_MODEL_NAME="Qwen/Qwen3-VL-30B-A3B-Instruct-FP8"

# Logs, temp files and api_key go in WORK_DIR; caches in CACHE_ROOT.
# Keep both off small or shared system disks.
WORK_DIR="/local/scratch/$USER/Project26/curio"
CACHE_ROOT="$HOME/curio-models/cache"

# Server settings.
PORT=8000
GPU_MEM_UTIL=0.90
MAX_MODEL_LEN=32768
MAX_IMAGES=4

# Latency knobs. Restart the server after changing any of these.
# Automatic prefix caching: reuses the KV cache of Curio's long, identical
# system prompt so only the new turn + screenshots are prefilled. It is already
# the default in vLLM 0.11 (V1 engine); this makes it explicit. 0 turns it off.
ENABLE_PREFIX_CACHING=1
# Optional, unset by default. Max concurrent sequences; a small value (e.g. 8)
# trims warmup/scheduler overhead for a single-user app. Leave empty for
# vLLM's default.
MAX_NUM_SEQS=
# Optional, unset by default. JSON for the Qwen-VL image processor. Curio
# sends images <= 1280px, which the processor does not upscale, so this only
# matters as a safety cap. Example (1280*1280 px, ~1600 tokens/image max):
#   MM_PROCESSOR_KWARGS='{"max_pixels": 1638400}'
# Verify with ./test_vision.sh after enabling; the kwarg name depends on the
# vLLM/transformers version.
MM_PROCESSOR_KWARGS=
